# ============ BẮT BUỘC ============
DISCORD_TOKEN=
GROQ_API_KEY=

# ============ MODEL ============
# Model chat chính (đổi được, có rate limit RIÊNG với prompt-guard)
CHAT_MODEL=openai/gpt-oss-120b
# Model phân loại prompt injection / jailbreak
GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# low = trả lời nhanh gọn (hợp chat Discord) | medium | high = suy luận sâu hơn, chậm hơn, tốn token hơn
REASONING_EFFORT=low

# ============ RATE LIMIT ============
# Limit của meta-llama/llama-prompt-guard-2-86m (30 RPM / 14.4K RPD / 15K TPM / 500K TPD)
GUARD_RPM=30
GUARD_RPD=14400
GUARD_TPM=15000
GUARD_TPD=500000

# Limit của model chat (openai/gpt-oss-120b) — SỐ THẬT lấy từ console.groq.com/settings/limits, đây là trần cứng, không tăng được trên free tier
CHAT_RPM=30
CHAT_RPD=1000
CHAT_TPM=8000
CHAT_TPD=200000

# Chờ tối đa bao nhiêu giây khi hàng đợi đang đầy (0 = bỏ qua luôn tin nhắn)
CHAT_MAX_WAIT=3.0
GUARD_MAX_WAIT=1.5

# ============ DANH TÍNH ============
BOT_NAME=bá khí bot
# Tên gọi khác, cách nhau bằng dấu phẩy — nhắc tên là bot trả lời
BOT_ALIASES=ba khi,bá khí,bakhibot,bó kí bot

# ============ CHAT TỰ ĐỘNG ============
# Bật chat tự động mặc định ở mọi kênh (true) hay phải /genz chat bật từng kênh (false)
AMBIENT_DEFAULT=true
# Xác suất nhảy vào chat khi KHÔNG bị tag (0.0 - 1.0). 0.08 = 8%
REPLY_CHANCE=0.08
# Sau khi tự nhảy vào, nghỉ bao nhiêu giây trong kênh đó
CHANNEL_COOLDOWN=25
# Bỏ qua tin nhắn ngắn hơn n ký tự khi chat tự động
MIN_LENGTH=4
# Số tin nhắn gần nhất đưa vào context mỗi kênh (giữ thấp — TPM 8K của free tier không kham nổi lịch sử dài)
MAX_HISTORY=6

REPLY_MAX_TOKENS=160
TEMPERATURE=0.95

# Chỉ chạy ở các kênh này (ID, cách nhau dấu phẩy). Để trống = tất cả kênh
ALLOW_CHANNELS=
# Không bao giờ chạy ở các kênh này
DENY_CHANNELS=
ALLOW_DM=false

# ============ "LỖI KẾT NỐI" KHI BỊ CHỬI ============
COOLDOWN_SECONDS=300
# Bao lâu sửa embed đếm ngược 1 lần (giây). Đừng để < 3 kẻo dính rate limit Discord
COUNTDOWN_INTERVAL=5
# user = im với riêng người chửi | channel = im cả kênh | global = im toàn server
COOLDOWN_SCOPE=user
# Sau khi "kết nối lại" thì thả 1 câu khịa nhẹ
COMEBACK_ROAST=true
# true = chỉ giận khi bị chửi THẲNG vào mặt bot (tag / reply / gọi tên)
# false = ai chửi nhau trong kênh cũng giận (rất dễ bị trigger, cân nhắc)
INSULT_REQUIRE_TARGET=true

# ============ PROMPT GUARD ============
GUARD_ENABLED=true
# Chỉ quét prompt-guard khi bot bị nhắm tới (tiết kiệm 30 RPM). Bật true để quét mọi tin nhắn
GUARD_ON_AMBIENT=false

# ============ DEV ============
# Điền guild ID để slash command sync tức thì khi dev (để trống = sync global, chờ tới 1h)
DEV_GUILD_ID=
LOG_LEVEL=INFO
